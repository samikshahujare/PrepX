# ==============================================================================
# PrepX Backend Environment Configuration Template
# Copy this file to backend/.env and replace placeholders with your actual values
# ==============================================================================

# Application Configuration
APP_NAME="PrepX Backend API"
APP_ENV=development
DEBUG=True
API_V1_STR="/api/v1"

# Cryptographic Security
# Generate a 256-bit secure key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_secure_random_hex_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL Database (Port 5432)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=prepx_db
# Optional full connection URL (overrides separate POSTGRES_* settings if set)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/prepx_db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000"

# Public Application URLs for multiplayer group discussion invitations and external access
# APP_PUBLIC_URL=https://your-public-app.ngrok-free.app
# FRONTEND_URL=http://localhost:3000

# Multi-LLM Provider Configuration (Failover: Gemini -> NVIDIA -> Groq -> OpenRouter)
# Provider 1: Google Gemini (Primary)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Provider 2: NVIDIA NIM (Fallback #1)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# Provider 3: Groq Cloud (Fallback #2)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Provider 4: OpenRouter (Fallback #3)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free

# AI Interviewer Avatar Mode
AVATAR_PROVIDER=local
