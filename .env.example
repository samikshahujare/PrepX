# ==============================================================================
# PrepX Root Environment Configuration Template
# Copy this file to backend/.env and frontend/.env.local (or root .env)
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (backend/.env)
# ------------------------------------------------------------------------------

# Application Configuration
APP_NAME="PrepX Backend API"
APP_ENV=development
DEBUG=True
API_V1_STR="/api/v1"

# Cryptographic Security
# Generate a 256-bit secure key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_secure_random_hex_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL Database (Port 5432 - Coexists with MySQL on 3306)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=prepx_db
# Optional full connection URL for managed PostgreSQL (Supabase, Neon, Render, Railway, AWS RDS)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/prepx_db

# CORS Allowed Origins (Comma-separated specific origins; never use wildcard '*' when credentials are enabled)
# In production, include your production frontend origin (e.g. https://your-prepx-app.vercel.app)
CORS_ORIGINS="http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000"

# Public Application URLs for multiplayer group discussion invitations and external access
# In production, set to your canonical frontend URL (e.g. https://your-prepx-app.vercel.app)
# APP_PUBLIC_URL=https://your-prepx-app.vercel.app
# FRONTEND_URL=https://your-prepx-app.vercel.app

# Multi-LLM Provider Configuration (Automatic Failover: Gemini -> NVIDIA -> Groq -> OpenRouter)
# Provider 1: Google Gemini (Primary tier)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Provider 2: NVIDIA NIM (Fallback #1)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# Provider 3: Groq Cloud (Fallback #2)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Provider 4: OpenRouter (Fallback #3)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free

# AI Interviewer Avatar Mode ("local" renders 3D WebGL / 2D Canvas)
AVATAR_PROVIDER=local

# ------------------------------------------------------------------------------
# Frontend Configuration (frontend/.env.local)
# ------------------------------------------------------------------------------

# FastApi Backend API Endpoint
# In local development: http://localhost:8000/api/v1
# In production: https://api.your-prepx-backend.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Public Application URL (Used for generating externally shareable Group Discussion invitations)
# In production, set to your canonical public frontend domain (e.g. on Vercel):
# NEXT_PUBLIC_APP_URL=https://your-prepx-app.vercel.app

# Optional dedicated WebSocket endpoint (if not specified, derived automatically from NEXT_PUBLIC_API_URL)
# In production: wss://api.your-prepx-backend.com
# NEXT_PUBLIC_WS_URL=wss://api.your-prepx-backend.com
