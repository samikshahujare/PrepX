# ==============================================================================
# PrepX Frontend Environment Configuration Template
# Copy this file to frontend/.env.local before running the development server
# ==============================================================================

# FastApi Backend API Endpoint
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Public Application URL (Used for generating externally shareable Group Discussion invitations)
# In development with ngrok/tunnel or in production, set to your canonical public domain:
# NEXT_PUBLIC_APP_URL=https://your-public-app.ngrok-free.app

# Optional dedicated WebSocket endpoint (if not specified, derived automatically from NEXT_PUBLIC_API_URL)
# NEXT_PUBLIC_WS_URL=wss://your-public-api.ngrok-free.app
